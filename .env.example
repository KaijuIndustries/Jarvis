# Jarvis local configuration
# Copy to `.env.local` for development or `.env` on the Ubuntu VM.

# Ollama HTTP API. Keep this pointed at the inference host, not at Jarvis.
# Same VM:
OLLAMA_BASE_URL=http://localhost:11434
# Later, a dedicated GPU machine:
# OLLAMA_BASE_URL=http://192.168.x.x:11434

# Ollama hosted web search (https://ollama.com/settings/keys).
# Leave empty here and save a key in Jarvis Settings, or set it in `.env`.
OLLAMA_API_KEY=
# OLLAMA_WEB_SEARCH_URL=https://ollama.com/api/web_search

# Models allowed to use web search. "*" = all. Example: llama3.2,qwen3
WEB_SEARCH_MODELS=*

# Home Assistant REST API (port 80 in this setup; do not assume 8123).
# The long-lived token stays on the Jarvis server. Never put it in client code.
HOME_ASSISTANT_URL=http://192.168.1.80
HOME_ASSISTANT_TOKEN=
# Models allowed to use Home Assistant tools. "*" = all.
# HOME_ASSISTANT_MODELS=*
# Optional discovery cache TTL in milliseconds (default 12 minutes).
# HOME_ASSISTANT_CACHE_MS=720000

# PostgreSQL (Docker: jarvis-postgres). Never expose this to the browser.
DATABASE_URL=postgresql://jarvis:PASSWORD@localhost:5432/jarvis

# Hostnames allowed to reach `next dev` from the LAN (comma-separated, no protocol).
# Production (`npm start`) does not need this.
# ALLOWED_DEV_ORIGINS=192.168.1.50

# Local Wyoming Whisper (TCP). The browser never talks to this service.
WYOMING_WHISPER_URL=127.0.0.1:10300
WYOMING_WHISPER_LANGUAGE=en

# Local Wyoming Piper (TCP). The browser never talks to this service.
WYOMING_PIPER_URL=127.0.0.1:10200
WYOMING_PIPER_VOICE=en_GB-alba-medium

# Local openWakeWord prototype (HTTP). Jarvis proxies this; the browser never
# talks to the Python service directly.
WAKEWORD_URL=127.0.0.1:10400
# Python wake service (jarvis-wake / docker-compose.wake.yml):
# WAKEWORD_THRESHOLD=0.5
# WAKEWORD_CONFIRM_FRAMES=2
# WAKEWORD_VAD_THRESHOLD=0.5
# WAKEWORD_COOLDOWN=3
# WAKEWORD_DEBUG=true
