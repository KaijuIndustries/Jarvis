# Jarvis local configuration
# Copy to `.env.local` for development or `.env` on the Ubuntu VM.

# Ollama HTTP API. Keep this pointed at the inference host, not at Jarvis.
# Same VM:
OLLAMA_BASE_URL=http://localhost:11434
# Later, a dedicated GPU machine:
# OLLAMA_BASE_URL=http://192.168.x.x:11434

# Hostnames allowed to reach `next dev` from the LAN (comma-separated, no protocol).
# Production (`npm start`) does not need this.
# ALLOWED_DEV_ORIGINS=192.168.1.50
